# dependencies
/node_modules
/.pnpm-store

# next.js
/.next/
/out/

# production
/build
# zkompilovaný worker (npm run build:worker)
/dist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# logy z lokálního běhu (npm run dev > dev.log apod.)
/dev.log
/worker.log
/docker-build.log

# local env files
#
# Plošně všechny varianty, ne jen vyjmenované. Dřív tu stálo `.env`,
# `.env.production`, `.env.local` a `.env*.local` – takže `.env.test` nebo
# `.env.staging` by se bez varování commitly i s obsahem. Vzor `.env.example`
# je jediná výjimka a commituje se schválně.
.env*
!.env.example

# uploads – hotové WebP varianty
/public/uploads/*
!/public/uploads/.gitkeep

# dočasné originály čekající na zpracování workerem
/storage

# zálohy databáze a souborů (deploy/zaloha.sh je tam ukládá)
/zalohy

# klíče a certifikáty
#
# Pojistka, ne popis skutečnosti: dnes v repozitáři žádný takový soubor není
# a nemá tu co dělat. Klíče k bráně, SMTP i TLS chodí přes `.env`, případně je
# vyrábí Caddy sám ve svém svazku. Kdyby sem někdy nějaký patřil, musí se
# přidat vědomě přes `git add -f`.
*.pem
*.key
*.p12
*.pfx

# výstup z `vitest --coverage`
/coverage

# smetí z operačního systému
.DS_Store
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
