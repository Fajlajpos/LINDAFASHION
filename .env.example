# Zkopíruj na `.env` a vyplň. Commituje se jen tenhle vzor, nikdy `.env`.

# --- Databáze ---------------------------------------------------------------
# Lokální vývoj (docker-compose.dev.yml běží na 5433, aby se nepral s nativním PG):
#   postgresql://linda:lindapassword@localhost:5433/linda_fashion?schema=public
# V produkčním compose se DATABASE_URL nastavuje automaticky na hostname `postgres`.
DATABASE_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=linda_fashion

# Databáze pro integrační testy. Nepovinné – když se nevyplní, odvodí se
# z DATABASE_URL. Název MUSÍ končit na `_test`, jinak se testy odmítnou
# spustit; je to jediná pojistka proti smazání vývojové databáze.
DATABASE_URL_TEST=

# Vypisování SQL dotazů do konzole při vývoji. Zapíná se hodnotou `1`.
PRISMA_LOG_QUERIES=

# --- Autentizace ------------------------------------------------------------
# Podepisuje JWT session cookie. Vygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
APP_URL=http://localhost:3000

# Na které rozhraní produkční compose vyvěsí port 3000.
# Výchozí `127.0.0.1` znamená, že na web jde zvenčí jen přes Caddy
# (`docker compose --profile proxy up -d`). Limity požadavků se opírají
# o hlavičku X-Forwarded-For od proxy; při přímém vystavení portu si ji
# může kdokoliv vymyslet a brzdu na přihlašování tím obejít.
# Bez proxy nastav `0.0.0.0` – vědomě.
WEB_BIND=127.0.0.1

# Prvotní admin účet – při startu se z něj založí uživatel s rolí ADMIN,
# pokud v databázi ještě žádný admin není. Heslo se ukládá bcrypt hashované.
# Pozdější změna hesla: npm run admin:reset-heslo -- <email> <nove-heslo>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Nahrávání a zpracování obrázků ----------------------------------------
UPLOAD_MAX_MB=15
# Strop na celou dávku najednou. `request.formData()` si tělo natáhne do
# paměti, takže dvacet souborů po 15 MB znamená 300 MB v RAM jednoho
# požadavku – na malém VPS to shodí celý kontejner `web`.
UPLOAD_MAX_BATCH_MB=60
UPLOAD_DIR=public/uploads
UPLOAD_TMP_DIR=storage/tmp

# --- Zálohy ------------------------------------------------------------------
# Zálohuje kontejner `zalohy` v produkčním compose (`deploy/zaloha.sh`).
# Ve vývoji neběží a administrace to hlásí jen jako doporučení, ne jako chybu.
#
# Jak dlouho se zálohy drží. Není to jen o místu na disku: záloha obsahuje
# osobní údaje, které retenční úloha z živé databáze už smazala, takže tohle
# číslo určuje, jak dlouho smazaná data ještě přežívají. Změna se musí promítnout
# do `dokumenty/zaznamy-o-cinnostech-zpracovani.md`.
ZALOHY_DNU=30
# Kdy se spouští, HH:MM v UTC. Kontejnery nemají `tzdata`, takže i plánované
# úlohy workeru jedou v UTC. 04:10 je schválně až po retenci ve 03:20.
ZALOHY_CAS=04:10

# --- Captcha / ochrana proti spamu -----------------------------------------
# Cloudflare Turnstile. Zapíná se oběma klíči najednou: bez nich se widget
# nevykreslí a serverové ověření propouští, takže formuláře fungují dál.
# Vyplněním se ochrana zapne na obou stranách současně – kdyby se zapnula jen
# serverová, zavřel by se každý formulář na webu.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Platby: GoPay ---------------------------------------------------------
# Vyplněním všech tří hodnot se v pokladně zpřístupní platba kartou; bez nich
# e-shop nabízí jen bankovní převod (rozhoduje se za běhu, ne v buildu).
#
# GOPAY_ENV musí být doslova `production`, aby se použila ostrá brána.
# Cokoliv jiného (i překlep) míří do sandboxu, kde se nic neúčtuje.
#
# V administraci GoPay je potřeba povolit notifikační adresu:
#   https://<doména>/api/platba/gopay/notifikace
# Bez ní se objednávka po zaplacení neoznačí sama – notifikace server–server
# je hlavní cesta, návrat zákaznice z brány je jen urychlení.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_ENV=sandbox

# --- Bankovní převod (dočasný můstek, funguje bez API) ---------------------
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- Doprava (doplní se, až budou klíče) -----------------------------------
# Zásilkovna. API klíč slouží i widgetu pro výběr výdejního místa v pokladně
# (je veřejný, posílá se do stránky); API heslo je tajné a zůstává na serveru.
#
# PACKETA_ESHOP je interní „Označení" odesílatele z klientské sekce
# (Informace o uživateli → Odesílatelé). Posílá se v každém požadavku na
# založení zásilky a musí sedět na znak — malá písmena, bez mezer a diakritiky.
# Bez něj se zakládání zásilek v administraci vůbec nenabídne.
PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PACKETA_ESHOP=
PPL_API_KEY=
PPL_USERNAME=
PPL_PASSWORD=
CESKA_POSTA_API_KEY=

# --- E-mail ----------------------------------------------------------------
# Odesílání je zapojené (nodemailer, worker). Povinné je SMTP_HOST a
# EMAIL_FROM – bez nich se zpráva jen vypíše do logu workeru, což je i výchozí
# stav. SMTP_USER/SMTP_PASSWORD zůstávají prázdné u relaye ve stejné síti,
# který autentizaci nechce (Mailpit ve vývoji, Postfix v compose).
#
# SMTP_PORT=465 znamená implicitní TLS, cokoliv jiného STARTTLS. Špatná
# hodnota se neprojeví chybou, ale timeoutem při odesílání.
#
# VÝVOJ — Mailpit z docker-compose.dev.yml. Nic neodejde ven, všechno se
# ukáže na http://localhost:8025. Ostrou schránku ve vývoji nepoužívej:
# testovací objednávky by chodily lidem do pošty a ujídaly denní limit.
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=        (Mailpit autentizaci nechce)
#   SMTP_PASSWORD=
#
# PRODUKCE přes Gmail — SMTP_PASSWORD je **heslo aplikace**, nikdy běžné
# heslo k účtu. Vygeneruje se v Google účtu (Zabezpečení → Hesla aplikací)
# a jde jen tehdy, když má účet zapnuté dvoufázové ověření. Je to 16 znaků
# a Google ho ukáže jedinkrát.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=<adresa@gmail.com>
#   SMTP_PASSWORD=<heslo aplikace, bez mezer>
#
# EMAIL_FROM se musí shodovat s SMTP_USER. Gmail odmítá odesílat pod cizí
# adresou, takže nesedící odesílatel skončí chybou nebo přepsanou hlavičkou.
# Zápis „Jméno <adresa>“ je v pořádku, rozhoduje adresa v lomených závorkách.
#
# Zdarma má Gmail limit kolem 500 zpráv denně. Na boutique to stačí; kdyby
# někdy nestačilo, přechod na doménovou schránku je změna těchhle čtyř řádků.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Analytika a marketing (volitelné) -------------------------------------
#
# POZOR: `NEXT_PUBLIC_*` se vpéká do stránky při BUILDU, ne za běhu. Po jejich
# vyplnění je nutné image přestavět (`docker compose up -d --build`) – samotný
# restart kontejneru nestačí a skripty se nenačtou. Compose je předává jako
# build args, viz `docker-compose.yml`.
#
# Obojí se navíc načte teprve po souhlasu v cookie liště.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CATALOG_FEED_URL=
GOOGLE_MERCHANT_ID=

# --- Cloudové úložiště obrázků (volitelné, do budoucna) --------------------
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET=
CLOUD_STORAGE_BUCKET=

# Firemní a kontaktní údaje tady schválně NEJSOU – edituje je admin
# v administraci a žijí v tabulce Settings (sekce 6.8 a 7 zadání).
