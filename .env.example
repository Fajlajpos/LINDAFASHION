# Zkopíruj na `.env` a vyplň. Commituje se jen tenhle vzor, nikdy `.env`.

# --- Databáze ---------------------------------------------------------------
# Lokální vývoj (docker-compose.dev.yml běží na 5433, aby se nepral s nativním PG):
#   postgresql://linda:lindapassword@localhost:5433/linda_fashion?schema=public
# V produkčním compose se DATABASE_URL nastavuje automaticky na hostname `postgres`.
DATABASE_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=linda_fashion

# --- Autentizace ------------------------------------------------------------
# Podepisuje JWT session cookie. Vygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
APP_URL=http://localhost:3000

# Prvotní admin účet – při startu se z něj založí uživatel s rolí ADMIN,
# pokud v databázi ještě žádný admin není. Heslo se ukládá bcrypt hashované.
# Pozdější změna hesla: npm run admin:reset-heslo -- <email> <nove-heslo>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Nahrávání a zpracování obrázků ----------------------------------------
UPLOAD_MAX_MB=15
UPLOAD_DIR=public/uploads
UPLOAD_TMP_DIR=storage/tmp

# --- Captcha / ochrana proti spamu -----------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Platby: GoPay (doplní se, až budou klíče) -----------------------------
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_ENV=sandbox

# --- Bankovní převod (dočasný můstek, funguje bez API) ---------------------
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- Doprava (doplní se, až budou klíče) -----------------------------------
PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PPL_API_KEY=
PPL_USERNAME=
PPL_PASSWORD=
CESKA_POSTA_API_KEY=

# --- E-mail (doplní se, až budou přístupy) ---------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Analytika a marketing (volitelné) -------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CATALOG_FEED_URL=
GOOGLE_MERCHANT_ID=

# --- Cloudové úložiště obrázků (volitelné, do budoucna) --------------------
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET=
CLOUD_STORAGE_BUCKET=

# Firemní a kontaktní údaje tady schválně NEJSOU – edituje je admin
# v administraci a žijí v tabulce Settings (sekce 6.8 a 7 zadání).
