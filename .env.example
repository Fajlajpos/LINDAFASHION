# Zkopíruj na `.env` a vyplň. Commituje se jen tenhle vzor, nikdy `.env`.

# --- Databáze ---------------------------------------------------------------
# Lokální vývoj (docker-compose.dev.yml běží na 5433, aby se nepral s nativním PG):
#   postgresql://linda:lindapassword@localhost:5433/linda_fashion?schema=public
# V produkčním compose se DATABASE_URL nastavuje automaticky na hostname `postgres`.
DATABASE_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=linda_fashion

# --- Autentizace ------------------------------------------------------------
# Podepisuje JWT session cookie. Vygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
APP_URL=http://localhost:3000

# Na které rozhraní produkční compose vyvěsí port 3000.
# Výchozí `127.0.0.1` znamená, že na web jde zvenčí jen přes Caddy
# (`docker compose --profile proxy up -d`). Limity požadavků se opírají
# o hlavičku X-Forwarded-For od proxy; při přímém vystavení portu si ji
# může kdokoliv vymyslet a brzdu na přihlašování tím obejít.
# Bez proxy nastav `0.0.0.0` – vědomě.
WEB_BIND=127.0.0.1

# Prvotní admin účet – při startu se z něj založí uživatel s rolí ADMIN,
# pokud v databázi ještě žádný admin není. Heslo se ukládá bcrypt hashované.
# Pozdější změna hesla: npm run admin:reset-heslo -- <email> <nove-heslo>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Nahrávání a zpracování obrázků ----------------------------------------
UPLOAD_MAX_MB=15
UPLOAD_DIR=public/uploads
UPLOAD_TMP_DIR=storage/tmp

# --- Captcha / ochrana proti spamu -----------------------------------------
# Cloudflare Turnstile. Zapíná se oběma klíči najednou: bez nich se widget
# nevykreslí a serverové ověření propouští, takže formuláře fungují dál.
# Vyplněním se ochrana zapne na obou stranách současně – kdyby se zapnula jen
# serverová, zavřel by se každý formulář na webu.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Platby: GoPay ---------------------------------------------------------
# Vyplněním všech tří hodnot se v pokladně zpřístupní platba kartou; bez nich
# e-shop nabízí jen bankovní převod (rozhoduje se za běhu, ne v buildu).
#
# GOPAY_ENV musí být doslova `production`, aby se použila ostrá brána.
# Cokoliv jiného (i překlep) míří do sandboxu, kde se nic neúčtuje.
#
# V administraci GoPay je potřeba povolit notifikační adresu:
#   https://<doména>/api/platba/gopay/notifikace
# Bez ní se objednávka po zaplacení neoznačí sama – notifikace server–server
# je hlavní cesta, návrat zákaznice z brány je jen urychlení.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_ENV=sandbox

# --- Bankovní převod (dočasný můstek, funguje bez API) ---------------------
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# --- Doprava (doplní se, až budou klíče) -----------------------------------
PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PPL_API_KEY=
PPL_USERNAME=
PPL_PASSWORD=
CESKA_POSTA_API_KEY=

# --- E-mail ----------------------------------------------------------------
# Odesílání je zapojené (nodemailer, worker). Povinné je SMTP_HOST a
# EMAIL_FROM – bez nich se zpráva jen vypíše do logu workeru, což je i výchozí
# stav. SMTP_USER/SMTP_PASSWORD zůstávají prázdné u relaye ve stejné síti,
# který autentizaci nechce (Mailpit ve vývoji, Postfix v compose).
#
# SMTP_PORT=465 znamená implicitní TLS, cokoliv jiného STARTTLS. Špatná
# hodnota se neprojeví chybou, ale timeoutem při odesílání.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Analytika a marketing (volitelné) -------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CATALOG_FEED_URL=
GOOGLE_MERCHANT_ID=

# --- Cloudové úložiště obrázků (volitelné, do budoucna) --------------------
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET=
CLOUD_STORAGE_BUCKET=

# Firemní a kontaktní údaje tady schválně NEJSOU – edituje je admin
# v administraci a žijí v tabulce Settings (sekce 6.8 a 7 zadání).
