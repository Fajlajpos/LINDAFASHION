{
  // Build workeru do dist/ pro produkční kontejner (npm run build:worker).
  // Ve vývoji se worker pouští přes ts-node s tsconfig.node.json.
  //
  // `include` je jen vstupní bod; TypeScript si přes importy dotáhne i src/lib/*.ts,
  // které worker používá. Proto v kódu workeru drž relativní importy (../lib/db),
  // ne alias @/ – tsc cesty v outputu nepřepisuje.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/worker/**/*.ts"],

  // Testy do produkčního obrazu nepatří – a nejde jen o pár kilobajtů.
  // Testovací pomocníci (`src/test/data.ts`) importují validace, ty zase
  // klienta platební brány, takže se přes jeden `.test.ts` do buildu workeru
  // vtáhnou moduly, které tam nemají co dělat. Build pak padal na typech
  // webového `fetch`, přestože se ten kód ve workeru nikdy nespustí.
  "exclude": ["src/worker/**/*.test.ts"]
}
