generator client {
  provider = "prisma-client-js"

  // "native" = vývojový stroj (Windows).
  // "linux-musl-openssl-3.0.x" = produkční kontejner nad node:20-alpine.
  //
  // Bez druhého cíle se image sice postaví, ale při prvním dotazu do databáze
  // spadne na `Error loading shared library libssl.so.1.1` – Prisma si bez
  // nápovědy vybere engine pro OpenSSL 1.1, který dnešní Alpine nemá.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  passwordHash      String
  jmeno             String?
  telefon           String?
  role              Role    @default(CUSTOMER)
  newsletterSouhlas Boolean @default(false)

  // Číslo se nese v session tokenu. Zvýšením se okamžitě zneplatní všechny
  // dosud vydané přihlášení – používá se při změně/resetu hesla a při odebrání
  // administrátorských práv. Bez toho by odhlášený token platil až do vypršení.
  tokenVerze Int @default(0)

  // GDPR: účet se nemaže fyzicky (objednávky jsou účetní doklad), ale
  // anonymizuje – tohle je značka, že se tak stalo.
  anonymizovanoAt DateTime?

  createdAt   DateTime        @default(now())
  addresses   Address[]
  orders      Order[]
  favorites   Favorite[]
  cart        Cart?
  resetTokeny PasswordReset[]
}

/// Jednorázový token pro obnovu zapomenutého hesla.
/// Ukládá se jen hash tokenu – kdyby někdo získal přístup k databázi,
/// ze záznamu se odkaz na reset nedá zpětně sestavit.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  platnyDo  DateTime
  pouzitoAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Address {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jmenoPrijmeni String
  ulice         String
  mesto         String
  psc           String
  zeme          String      @default("CZ")
  telefon       String?
  jeVychozi     Boolean     @default(false)
  typ           AddressType
}

enum AddressType {
  FAKTURACNI
  DODACI
}

model Category {
  id       String     @id @default(cuid())
  nazev    String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  popis    String?
  obrazek  String?
  poradi   Int        @default(0)
  products Product[]

  /// Název bez diakritiky a malými písmeny – aby „saty" našlo „Šaty".
  /// Plní ho `hledaciNazevKategorie()` při každém zápisu kategorie.
  hledaciNazev String @default("")
}

model Product {
  id              String           @id @default(cuid())
  nazev           String
  slug            String           @unique
  popis           String
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  cena            Decimal
  cenaPoSleve     Decimal?
  znacka          String?
  material        String?
  udrzba          String?
  sku             String?          @unique
  aktivni         Boolean          @default(true)
  doporuceny      Boolean          @default(false)
  jeDarkovyPoukaz Boolean          @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]
  images          ProductImage[]
  favorites       Favorite[]

  /// Název, značka, popis, SKU a materiál slité do jednoho řetězce bez
  /// diakritiky a malými písmeny. Plní ho `hledaciTextProduktu()` při každém
  /// zápisu produktu; hledá se výhradně tady, ne v původních sloupcích.
  ///
  /// Index tu vědomě není: `LIKE '%slovo%'` běžný B-strom nepoužije, pomohl by
  /// až GIN nad `pg_trgm`. Katalog butiku má řádově stovky řádků, sekvenční
  /// průchod jednoho textového sloupce je na tuhle velikost levnější než
  /// rozšíření navíc. Až by katalog narostl na desetitisíce, je to první
  /// místo, kam sáhnout.
  hledaciText String @default("")

  /// --- § 12a zákona o ochraně spotřebitele: sleva se počítá z nejnižší ceny ---
  ///
  /// Tohle NENÍ klouzavé okno. Zákon říká „nejnižší cena v době 30 dnů **před
  /// poskytnutím** slevy", takže se hodnota **zmrazí v okamžiku, kdy sleva
  /// začne**, a po celou dobu jejího trvání se už nemění. Kdyby se počítala
  /// průběžně, po pár dnech by se do okna dostala i samotná akční cena a
  /// referenční cena by se sesunula na ni – tedy „sleva z akční ceny", což je
  /// přesně ten trik, který novela zakazuje.
  ///
  /// Když se sleva bez přerušení prohlubuje (500 → 450 → 400), zůstává hodnota
  /// z prvního zlevnění; viz `slevaOd` a `zmenitCenuProduktu()` v cenova-historie.ts.
  ///
  /// Není null právě tehdy, když `cenaPoSleve` není null. V haléřích, aby
  /// porovnání běželo ve stejných jednotkách jako zbytek peněz (penize.ts).
  nejnizsiCena30DniHaleru Int?

  /// Začátek souvisle běžící slevy. Slouží k rozhodnutí, jestli nové zlevnění
  /// navazuje (referenční cena zůstává), nebo je to nová akce po přerušení
  /// (referenční cena se přepočítá).
  slevaOd DateTime?

  /// --- GPSR, nařízení (EU) 2023/988, účinné od 13. 12. 2024 ---
  ///
  /// U výrobku nabízeného online musí být uveden výrobce a kontakt na něj;
  /// u výrobce mimo EU navíc odpovědná osoba usazená v EU. Bez toho nesmí
  /// být výrobek vůbec nabízen – proto to hlídá i validace, ne jen formulář.
  vyrobceNazev  String?
  vyrobceAdresa String?
  vyrobceEmail  String?

  /// Odpovědná osoba v EU (čl. 16 GPSR). Povinná jen tehdy, když výrobce
  /// nesídlí v EU – u zboží od českého či italského dodavatele zůstává prázdná.
  odpovednaOsobaNazev  String?
  odpovednaOsobaAdresa String?
  odpovednaOsobaEmail  String?

  /// Varovné a bezpečnostní informace, které mají být připojeny k výrobku
  /// (čl. 19 GPSR) – u oděvů typicky drobné části u dětského zboží,
  /// hořlavost, teplota žehlení.
  bezpecnostniUpozorneni String?

  /// Údaje umožňující identifikaci výrobku (čl. 19 GPSR). `sku` je naše
  /// interní značení, tohle je identifikátor výrobce.
  ean        String?
  cisloSarze String?
  zemePuvodu String?

  /// --- Nařízení (EU) 1007/2011 o názvech textilních vláken ---
  ///
  /// Materiálové složení v procentech hmotnosti, sestupně („55 % len,
  /// 45 % bavlna"). Ukládá se odděleně od `material`, který je volný
  /// marketingový popis („jemný praný len") – zákon vyžaduje to první.
  slozeniMaterialu String?

  /// Čl. 12 téhož nařízení: obsahuje-li textilní výrobek netextilní části
  /// živočišného původu (kožený pásek u kabátu, rohové knoflíky, kožešinový
  /// límec), musí to být uvedeno větou „Obsahuje netextilní části živočišného
  /// původu". Není to totéž co složení vláken – tím se povinnost nesplní,
  /// protože `slozeniMaterialu` popisuje jen textilní část výrobku.
  obsahujeZivocisneCasti Boolean @default(false)

  cenovaHistorie PriceHistory[]

  // Katalog filtruje na aktivní a řadí podle novinek; admin listuje po kategoriích.
  @@index([aktivni, createdAt])
  @@index([categoryId])
}

/// Cenová evidence podle § 12a zákona č. 634/1992 Sb.
///
/// ČOI po e-shopu chce, aby uměl **doložit**, za kolik se zboží v konkrétní
/// den prodávalo. Samotné `Product.cena` to nedokáže: přepsáním sloupce
/// předchozí hodnota beze stopy zmizí a nejnižší cenu za 30 dnů není z čeho
/// spočítat. Proto se každá změna ceny zapisuje sem jako nový řádek.
///
/// Řádky se **nikdy nemění ani nemažou** – je to důkazní evidence. Úklidová
/// úloha smí zahodit jen záznamy starší než `ROKY_UCHOVANI_CEN`.
model PriceHistory {
  id        String  @id @default(cuid())
  productId String
  // `Restrict`, ne `Cascade`.
  //
  // S kaskádou by `db.product.delete()` tiše smazal i cenovou evidenci – tedy
  // právě to, co má dokládat, za kolik se zboží nabízelo. Smazání produktu je
  // z pohledu ČOI ta nejméně vhodná chvíle na ztrátu důkazů a nesmí se stát
  // jako vedlejší účinek údržby katalogu.
  //
  // Důsledek je záměr: produkt s evidencí nejde smazat jedním dotazem.
  // Endpoint proto rozhoduje vědomě – viz DELETE v api/admin/produkty/[id].
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Cena, za kterou se od `platnaOd` skutečně prodávalo – tedy `cenaPoSleve`,
  /// když sleva běží, jinak `cena`. Do výpočtu nejnižší ceny vstupuje tahle.
  cenaHaleru Int

  /// Základní (nepřeškrtnutá) cena ve stejném okamžiku. Sama o sobě do výpočtu
  /// nevstupuje, ale bez ní by z evidence nešlo poznat, jestli tehdy sleva
  /// běžela, nebo se jen měnil ceník.
  zakladniCenaHaleru Int

  jeSleva  Boolean  @default(false)
  platnaOd DateTime @default(now())

  /// Kdo změnu vyvolal – „admin:e-mail", „seed", „import". Bez toho se při
  /// kontrole nedá rozlišit ruční zásah od hromadné akce.
  zdroj String

  // Výpočet nejnižší ceny čte jeden produkt v okně posledních 30 dnů;
  // složený index přesně na ten dotaz.
  @@index([productId, platnaOd])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  velikost           String
  barva              String?
  skladem            Int                 @default(0)
  miry               Json?
  orderItems         OrderItem[]
  cartItems          CartItem[]
  stockNotifications StockNotification[]
}

model Cart {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime   @updatedAt
  pripomenutoAt DateTime?
  items         CartItem[]
}

model CartItem {
  id                String         @id @default(cuid())
  cartId            String
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mnozstvi          Int
  upozornenoNaSklad Boolean        @default(false)
  pridanoAt         DateTime       @default(now())

  @@unique([cartId, variantId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tři varianty, které vygeneruje worker Sharpem (sekce 9). Do doby, než je
  // hotovo, jsou null a administrace zobrazuje stav "zpracovává se".
  url       String? // velká (detail produktu, 1600 px)
  urlMedium String? // střední (výpisy katalogu, 800 px)
  urlThumb  String? // náhled (administrace, košík, 300 px)

  // Rozměry velké varianty – aby <Image> mohl rezervovat místo a nedělal CLS.
  sirka Int?
  vyska Int?

  altText        String?
  poradi         Int                   @default(0)
  jeHlavni       Boolean               @default(false)
  stavZpracovani ImageProcessingStatus @default(CEKA)
  chybaDuvod     String? // důvod selhání, když stavZpracovani = CHYBA
  originalSoubor String? // název dočasného originálu ve storage/tmp
  // Kdy si úlohu vyzvedl worker. Podle toho úklid pozná fotku, která uvízla
  // v ZPRACOVAVA_SE (worker spadl uprostřed práce), a zařadí ji znovu.
  zpracovaniOd   DateTime?
  createdAt      DateTime              @default(now())

  @@index([productId, poradi])
  @@index([stavZpracovani])
}

enum ImageProcessingStatus {
  CEKA
  ZPRACOVAVA_SE
  HOTOVO
  CHYBA
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cisloObjednavky String      @unique
  /// Kontaktní e-mail objednávky. Nepovinný jen kvůli řádkům založeným dřív,
  /// než sloupec existoval – nová objednávka ho má vždy. Bez něj neměla
  /// objednávka bez registrace na faktuře žádný kontakt.
  email           String?
  /// Náhodný klíč pro odkazy, které musí fungovat i bez přihlášení
  /// (potvrzení objednávky, stažení faktury). Číslo objednávky se k tomu
  /// použít nedá – jde po sobě, takže by šlo cizí objednávky procházet.
  verejnyToken    String      @unique @default(cuid())
  stav            OrderStatus @default(NOVA)

  /// Rozpis objednávky tak, jak platil v okamžiku nákupu.
  ///
  /// Dřív se na faktuře dopočítával zpětně z `procentoSlevy` slevového kódu
  /// a ze zbytku do `celkovaCena`. Jakmile ale majitelka u kódu procento
  /// změnila, vyšla faktura pro starou objednávku jinak a rozdíl se tiše
  /// schoval do dopravy. Rozpis je součást účetního dokladu – musí být
  /// zmrazený stejně jako doručovací adresa a `cenaVDobeNakupu`.
  mezisoucet  Decimal @default(0)
  slevaCastka Decimal @default(0)
  cenaDopravy Decimal @default(0)

  /// Součet zboží po slevě + doprava, tedy hodnota objednávky **před**
  /// uplatněním dárkového poukazu. Co zbývá doplatit = `celkovaCena - castkaZGiftCard`.
  celkovaCena       Decimal
  discountCodeId    String?
  discountCode      DiscountCode? @relation(fields: [discountCodeId], references: [id])
  giftCardId        String?
  giftCard          GiftCard?     @relation(fields: [giftCardId], references: [id])
  castkaZGiftCard   Decimal?
  zpusobDopravy     String
  vydejniMistoId    String?
  vydejniMistoNazev String?
  zpusobPlatby      String
  stavPlatby        String

  /// Identifikátor platby u brány (GoPay). Notifikace i návratová adresa
  /// nesou jen tohle id, takže je to jediná vazba mezi objednávkou a platbou.
  /// Unikátní schválně: jedna platba nesmí označit za zaplacené dvě objednávky.
  platbaId String? @unique

  cisloZasilky String?
  poznamka     String?
  zrusil       ZrusilKdo?

  /// --- Doklad o uzavření smlouvy (§ 1820 a § 1826 o. z.) ---
  ///
  /// Zaškrtnutí souhlasu s obchodními podmínkami se dosud jen validovalo
  /// a zahodilo. Při sporu ale musí prodávající doložit, **s čím přesně**
  /// zákaznice souhlasila – proto se ukládá okamžik i verze podmínek.
  /// Bez verze je záznam k ničemu: podmínky se mění a dnešní znění není to,
  /// které platilo u loňské objednávky.
  souhlasPodminkyAt DateTime?
  verzePodminek     String?

  /// IP, ze které objednávka přišla. Důkaz o uzavření smlouvy na dálku
  /// (oprávněný zájem, čl. 6 odst. 1 písm. f GDPR); maže ji retenční úloha
  /// dřív než zbytek objednávky, protože ji netřeba držet celých 10 let.
  ipObjednavky String?

  /// --- Lhůty, které běží od převzetí zboží ---
  ///
  /// Čtrnáctidenní lhůta pro odstoupení (§ 1829 o. z.) se počítá **ode dne
  /// převzetí**, ne od objednání. Bez tohohle data e-shop nedokáže říct,
  /// jestli je odstoupení včasné, a nemůže ani korektně zobrazit tlačítko
  /// podle § 1830a.
  datumExpedice DateTime?
  datumDoruceni DateTime?

  /// --- DPH: stav v době nákupu, ne dnešní ---
  ///
  /// `Settings.jePlatceDph` je aktuální stav e-shopu. Kdyby se majitelka
  /// plátcem stala později, přepočítaly by se podle něj i staré doklady –
  /// a faktura je účetní doklad, který se zpětně měnit nesmí. Proto snímek.
  jePlatceDph         Boolean     @default(false)
  sazbaDph            Int         @default(0)
  /// Výše DPH z `celkovaCena` v haléřích. Neplátce má 0.
  dphHaleru           Int         @default(0)
  dodaciJmenoPrijmeni String
  dodaciUlice         String
  dodaciMesto         String
  dodaciPsc           String
  dodaciZeme          String      @default("CZ")
  dodaciTelefon       String?
  createdAt           DateTime    @default(now())
  items               OrderItem[]
  reklamace           Reklamace[]

  @@index([userId])
  @@index([stav, createdAt])
}

enum ZrusilKdo {
  ZAKAZNICE
  ADMIN
}

enum OrderStatus {
  NOVA
  ZPRACOVAVA_SE
  EXPEDOVANA
  DORUCENA
  ZRUSENA
  VRACENA
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  mnozstvi            Int
  cenaVDobeNakupu     Decimal
  reklamace           Reklamace[]
  vygenerovanePoukazy GiftCard[]
}

model Favorite {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  upozornenoNaSklad Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, productId])
}

model DiscountCode {
  id            String    @id @default(cuid())
  kod           String    @unique
  procentoSlevy Int
  platnyOd      DateTime?
  platnyDo      DateTime?
  limitPouziti  Int?
  pocetPouziti  Int       @default(0)
  aktivni       Boolean   @default(true)
  orders        Order[]
}

model GiftCard {
  id                     String     @id @default(cuid())
  kod                    String     @unique
  castka                 Decimal
  zustatek               Decimal
  platnyDo               DateTime?
  aktivni                Boolean    @default(true)
  vytvorenoZObjednavkyId String?
  vytvorenoZObjednavky   OrderItem? @relation(fields: [vytvorenoZObjednavkyId], references: [id])
  createdAt              DateTime   @default(now())
  orders                 Order[]
}

model Settings {
  id                    Int       @id @default(1)
  rezimDovolene         Boolean   @default(false)
  datumNavratu          DateTime?
  zpravaProZakazniky    String?
  zablokovatObjednavky  Boolean   @default(false)
  nazevFirmy            String?
  icoFirmy              String?
  dicFirmy              String?
  adresaFirmy           String?
  telefonFirmy          String?
  emailFirmy            String?
  jePlatceDph           Boolean   @default(false)
  socialInstagram       String?
  socialFacebook        String?
  cenaDopravyZasilkovna Decimal?
  cenaDopravyPPL        Decimal?
  cenaDopravyCeskaPosta Decimal?
  prahDopravaZdarma     Decimal?

  /// --- Údaje povinné na obchodních listinách (§ 435 o. z.) ---
  ///
  /// Podnikatel musí na svých listinách i webu uvádět údaj o zápisu ve
  /// veřejném rejstříku (spisová značka), případně o zápisu v živnostenském
  /// rejstříku. Na faktuře i v patičce to dosud nebylo vůbec.
  zapisVRejstriku String?

  /// Základní sazba DPH v procentech. Uložená, ne zadrátovaná – sazby se
  /// mění zákonem a přepis konstanty v kódu je zbytečné nasazení.
  sazbaDph Int @default(21)

  /// Adresa pro vracené zboží. Bývá jiná než sídlo (sklad, výdejna) a musí
  /// být uvedena v poučení o odstoupení od smlouvy.
  adresaProVraceni String?

  /// Obvyklá doba dodání v pracovních dnech.
  ///
  /// § 1820 odst. 1 písm. h) o. z. ukládá sdělit dobu dodání **před**
  /// uzavřením smlouvy. Nikde na webu uvedená nebyla. Je to číslo, ne text:
  /// věta se dá poskládat na jednom místě a nemůže se rozejít mezi detailem
  /// produktu, pokladnou a obchodními podmínkami.
  dodaciLhutaDnu Int @default(3)

  /// --- GDPR: kontakt na správce (čl. 13 odst. 1) ---
  ///
  /// Adresa pro uplatnění práv subjektu údajů. Bez ní se zákaznice nemá kam
  /// obrátit se žádostí o výmaz nebo o přenositelnost.
  emailProGdpr String?

  /// --- Verze obchodních podmínek ---
  ///
  /// Zapisuje se ke každé objednávce (`Order.verzePodminek`). Po každé změně
  /// znění je potřeba ji zvednout, jinak snímek u objednávky ukazuje na text,
  /// který zákaznice nikdy neviděla. Formát je volný, doporučeně datum
  /// účinnosti: „2026-01-01".
  verzePodminek String @default("1")
}

/// Evidence udělených a odvolaných souhlasů (čl. 7 odst. 1 GDPR).
///
/// „Správce musí být schopen doložit, že subjekt údajů udělil souhlas."
/// Souhlas s cookies žil výhradně v `localStorage` prohlížeče, takže e-shop
/// v ruce neměl **nic** – a localStorage zákaznice si sama smaže. Tahle
/// tabulka je proto jediná evidence, která u kontroly ÚOOÚ obstojí.
///
/// Řádky jsou přírůstkové a neměnné: odvolání souhlasu se zapisuje jako nový
/// záznam s `udeleno = false`, nikdy se nepřepisuje ten původní. Jinak by
/// z evidence zmizelo, že souhlas nějakou dobu platil – a právě to je při
/// sporu o zákonnost zpracování ta podstatná informace.
model SouhlasZaznam {
  id  String      @id @default(cuid())
  typ TypSouhlasu

  /// Koho se souhlas týká: e-mail (newsletter, objednávka), nebo náhodné id
  /// návštěvnice z cookie u souhlasu s cookies. To id schválně **není**
  /// odvozené z IP ani z otisku prohlížeče – takový klíč by sám o sobě byl
  /// sledováním, které souhlas teprve povoluje.
  subjekt String

  udeleno Boolean

  /// Co přesně bylo zaškrtnuto – u cookies `{ analyticke, marketingove }`.
  /// Bez rozpisu by se nedalo doložit, že marketing zapnutý nebyl.
  podrobnosti Json?

  /// Verze textu, se kterým zákaznice souhlasila (podmínky, zásady cookies).
  verze String?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  // Typický dotaz: „jaký je poslední stav souhlasu tohoto subjektu".
  @@index([subjekt, typ, createdAt])
  @@index([typ, createdAt])
}

enum TypSouhlasu {
  COOKIES
  NEWSLETTER
  OBCHODNI_PODMINKY
}

model NewsletterSubscriber {
  id        String  @id @default(cuid())
  email     String  @unique
  potvrzeno Boolean @default(false)

  /// Doložení souhlasu podle čl. 7 odst. 1 GDPR a § 7 zák. č. 480/2004 Sb.
  ///
  /// Samotné `potvrzeno = true` u kontroly neobstojí – ÚOOÚ se ptá **kdy**
  /// a **odkud** souhlas přišel. Bez toho je důkazní břemeno na prodávajícím
  /// a nedá se unést. Obě IP jsou uložené proto, že double opt-in má dva
  /// kroky a doložit je potřeba oba.
  potvrzenoAt  DateTime?
  ipPrihlaseni String?
  ipPotvrzeni  String?
  /// Odkud přihlášení přišlo – "hero", "paticka". Kvůli měření, ne kvůli funkci.
  zdroj        String?
  odhlasenAt   DateTime?

  /// Klíč do odhlašovacího odkazu (a později do potvrzení double opt-inu).
  /// E-mail se do odkazu dát nesmí: kdokoliv by pak odhlásil kohokoliv,
  /// komu uhodne adresu. Token je náhodný a váže se na jediný záznam.
  token String @unique @default(cuid())

  createdAt DateTime @default(now())
}

model StockNotification {
  id        String         @id @default(cuid())
  email     String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vyrizeno  Boolean        @default(false)
  createdAt DateTime       @default(now())

  // Jeden e-mail hlídá jednu velikost jednou – bez toho by opakované kliknutí
  // založilo hlídání znovu a zákaznici přišlo několik stejných zpráv.
  @@unique([variantId, email])
  @@index([vyrizeno])
}

/// Zprávy z kontaktního formuláře (sekce 12).
/// Ukládají se do databáze, ne jen odesílají e-mailem: dokud nejsou SMTP
/// přístupy, byla by odeslaná zpráva nenávratně ztracená.
model ContactMessage {
  id        String   @id @default(cuid())
  jmeno     String
  email     String
  predmet   String?
  zprava    String
  vyrizeno  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vyrizeno, createdAt])
}

model Reklamace {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId    String?
  orderItem      OrderItem?    @relation(fields: [orderItemId], references: [id])
  typ            ReklamaceTyp
  stav           ReklamaceStav @default(PRIJATA)
  duvod          String?
  poznamkaAdmina String?
  datumPrijeti   DateTime      @default(now())
  datumVyrizeni  DateTime?

  /// Zákonná lhůta na vyřízení, § 19 odst. 3 zák. č. 634/1992 Sb. – 30 dnů
  /// od uplatnění. Marným uplynutím vzniká zákaznici právo od smlouvy
  /// odstoupit, takže to není interní cíl, ale datum s právním následkem.
  /// Dopočítává se při založení, aby ho administrace mohla řadit a barvit.
  lhutaDo DateTime?

  /// Odstoupení i reklamaci musí umět podat i **nepřihlášená** zákaznice –
  /// právo má ze zákona každý spotřebitel, ne jen ten s účtem. Objednávka bez
  /// registrace nemá `userId`, takže vazba na osobu vede přes e-mail
  /// a přístup k detailu přes token, ne přes přihlášení.
  email String?
  token String  @unique @default(cuid())

  /// § 1830a o. z. (účinný od 19. 6. 2026) žádá automatické potvrzení
  /// odstoupení s datem a časem přijetí. Značka, že odešlo – aby opakované
  /// zpracování fronty neposlalo zákaznici totéž potvrzení podruhé.
  potvrzeniOdeslanoAt DateTime?

  // Zákaznice si v účtu vypisuje reklamace ke svým objednávkám; admin je
  // řadí podle stavu. Bez indexu na `orderId` je první z toho sekvenční sken.
  @@index([orderId])
  @@index([stav, datumPrijeti])
  // Hlídání blížící se třicetidenní lhůty v administraci.
  @@index([lhutaDo])
}

enum ReklamaceTyp {
  REKLAMACE
  VRACENI
}

enum ReklamaceStav {
  PRIJATA
  RESI_SE
  VYRIZENA_UZNANA
  VYRIZENA_ZAMITNUTA
}

// Jednoduchý audit log akcí administrátora (sekce 14) – kdo, kdy a co změnil.
// Schválně bez cizího klíče na User: záznam musí přežít i smazání účtu admina.
model AuditLog {
  id          String   @id @default(cuid())
  adminEmail  String
  akce        String // např. "produkt.vytvoren", "produkt.skryt"
  entita      String // např. "Product"
  entitaId    String?
  podrobnosti Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Znění právních dokumentů, na které se odkazují objednávky.
///
/// `Settings.verzePodminek` se snímkuje na každou objednávku (`Order.verzePodminek`),
/// jenže samotný text podmínek byl natvrdo v JSX – štítek tedy ukazoval na znění,
/// které nikdo neuchovával. Doložit „souhlasila s verzí 2026-01" jde jen tehdy,
/// když se ta verze dá otevřít a přečíst i po deseti změnách textu.
///
/// Tabulka je proto **append-only, stejně jako `PriceHistory`**: nové znění =
/// nový řádek s novou verzí. Řádek, na který se odkazuje byť jediná objednávka,
/// se nesmí přepsat – tím by se zpětně změnilo, s čím zákaznice souhlasila.
/// Unikátní dvojice (druh, verze) zajišťuje, že snímek u objednávky ukazuje
/// právě na jeden text.
model PravniDokument {
  id String @id @default(cuid())

  /// "obchodni-podminky", "reklamacni-rad", "ochrana-osobnich-udaju".
  /// Volný řetězec, ne enum: přibývají zákonem, ne vývojem, a migrace kvůli
  /// novému druhu dokumentu by byla zbytečná překážka.
  druh String

  /// Štítek verze, doporučeně datum účinnosti ("2026-01-01"). Právě tenhle
  /// řetězec se ukládá do `Order.verzePodminek`.
  verze String

  nadpis String

  /// Celý text dokumentu v Markdownu. Uložený jako text, ne jako HTML:
  /// vykreslení je věc šablony a HTML od administrátorky by byl vstup,
  /// který se rovnou vkládá do stránky.
  obsah String

  ucinnostOd DateTime
  createdAt  DateTime @default(now())

  @@unique([druh, verze])
  @@index([druh, ucinnostOd])
}
