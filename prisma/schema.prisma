generator client {
  provider = "prisma-client-js"

  // "native" = vývojový stroj (Windows).
  // "linux-musl-openssl-3.0.x" = produkční kontejner nad node:20-alpine.
  //
  // Bez druhého cíle se image sice postaví, ale při prvním dotazu do databáze
  // spadne na `Error loading shared library libssl.so.1.1` – Prisma si bez
  // nápovědy vybere engine pro OpenSSL 1.1, který dnešní Alpine nemá.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  jmeno             String?
  telefon           String?
  role              Role       @default(CUSTOMER)
  newsletterSouhlas Boolean    @default(false)

  // Číslo se nese v session tokenu. Zvýšením se okamžitě zneplatní všechny
  // dosud vydané přihlášení – používá se při změně/resetu hesla a při odebrání
  // administrátorských práv. Bez toho by odhlášený token platil až do vypršení.
  tokenVerze Int @default(0)

  // GDPR: účet se nemaže fyzicky (objednávky jsou účetní doklad), ale
  // anonymizuje – tohle je značka, že se tak stalo.
  anonymizovanoAt DateTime?

  createdAt     DateTime       @default(now())
  addresses     Address[]
  orders        Order[]
  favorites     Favorite[]
  cart          Cart?
  resetTokeny   PasswordReset[]
}

/// Jednorázový token pro obnovu zapomenutého hesla.
/// Ukládá se jen hash tokenu – kdyby někdo získal přístup k databázi,
/// ze záznamu se odkaz na reset nedá zpětně sestavit.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  platnyDo  DateTime
  pouzitoAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Address {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jmenoPrijmeni String
  ulice         String
  mesto         String
  psc           String
  zeme          String      @default("CZ")
  telefon       String?
  jeVychozi     Boolean     @default(false)
  typ           AddressType
}

enum AddressType {
  FAKTURACNI
  DODACI
}

model Category {
  id       String     @id @default(cuid())
  nazev    String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  popis    String?
  obrazek  String?
  poradi   Int        @default(0)
  products Product[]

  /// Název bez diakritiky a malými písmeny – aby „saty" našlo „Šaty".
  /// Plní ho `hledaciNazevKategorie()` při každém zápisu kategorie.
  hledaciNazev String @default("")
}

model Product {
  id              String           @id @default(cuid())
  nazev           String
  slug            String           @unique
  popis           String
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  cena            Decimal
  cenaPoSleve     Decimal?
  znacka          String?
  material        String?
  udrzba          String?
  sku             String?          @unique
  aktivni         Boolean          @default(true)
  doporuceny      Boolean          @default(false)
  jeDarkovyPoukaz Boolean          @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]
  images          ProductImage[]
  favorites       Favorite[]

  /// Název, značka, popis, SKU a materiál slité do jednoho řetězce bez
  /// diakritiky a malými písmeny. Plní ho `hledaciTextProduktu()` při každém
  /// zápisu produktu; hledá se výhradně tady, ne v původních sloupcích.
  ///
  /// Index tu vědomě není: `LIKE '%slovo%'` běžný B-strom nepoužije, pomohl by
  /// až GIN nad `pg_trgm`. Katalog butiku má řádově stovky řádků, sekvenční
  /// průchod jednoho textového sloupce je na tuhle velikost levnější než
  /// rozšíření navíc. Až by katalog narostl na desetitisíce, je to první
  /// místo, kam sáhnout.
  hledaciText String @default("")

  // Katalog filtruje na aktivní a řadí podle novinek; admin listuje po kategoriích.
  @@index([aktivni, createdAt])
  @@index([categoryId])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  velikost           String
  barva              String?
  skladem            Int                 @default(0)
  miry               Json?
  orderItems         OrderItem[]
  cartItems          CartItem[]
  stockNotifications StockNotification[]
}

model Cart {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime   @updatedAt
  pripomenutoAt DateTime?
  items         CartItem[]
}

model CartItem {
  id                String         @id @default(cuid())
  cartId            String
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mnozstvi          Int
  upozornenoNaSklad Boolean        @default(false)
  pridanoAt         DateTime       @default(now())

  @@unique([cartId, variantId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Tři varianty, které vygeneruje worker Sharpem (sekce 9). Do doby, než je
  // hotovo, jsou null a administrace zobrazuje stav "zpracovává se".
  url       String? // velká (detail produktu, 1600 px)
  urlMedium String? // střední (výpisy katalogu, 800 px)
  urlThumb  String? // náhled (administrace, košík, 300 px)

  // Rozměry velké varianty – aby <Image> mohl rezervovat místo a nedělal CLS.
  sirka Int?
  vyska Int?

  altText        String?
  poradi         Int                   @default(0)
  jeHlavni       Boolean               @default(false)
  stavZpracovani ImageProcessingStatus @default(CEKA)
  chybaDuvod     String? // důvod selhání, když stavZpracovani = CHYBA
  originalSoubor String? // název dočasného originálu ve storage/tmp
  // Kdy si úlohu vyzvedl worker. Podle toho úklid pozná fotku, která uvízla
  // v ZPRACOVAVA_SE (worker spadl uprostřed práce), a zařadí ji znovu.
  zpracovaniOd   DateTime?
  createdAt      DateTime              @default(now())

  @@index([productId, poradi])
  @@index([stavZpracovani])
}

enum ImageProcessingStatus {
  CEKA
  ZPRACOVAVA_SE
  HOTOVO
  CHYBA
}

model Order {
  id                  String        @id @default(cuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  cisloObjednavky     String        @unique
  /// Kontaktní e-mail objednávky. Nepovinný jen kvůli řádkům založeným dřív,
  /// než sloupec existoval – nová objednávka ho má vždy. Bez něj neměla
  /// objednávka bez registrace na faktuře žádný kontakt.
  email               String?
  /// Náhodný klíč pro odkazy, které musí fungovat i bez přihlášení
  /// (potvrzení objednávky, stažení faktury). Číslo objednávky se k tomu
  /// použít nedá – jde po sobě, takže by šlo cizí objednávky procházet.
  verejnyToken        String        @unique @default(cuid())
  stav                OrderStatus   @default(NOVA)

  /// Rozpis objednávky tak, jak platil v okamžiku nákupu.
  ///
  /// Dřív se na faktuře dopočítával zpětně z `procentoSlevy` slevového kódu
  /// a ze zbytku do `celkovaCena`. Jakmile ale majitelka u kódu procento
  /// změnila, vyšla faktura pro starou objednávku jinak a rozdíl se tiše
  /// schoval do dopravy. Rozpis je součást účetního dokladu – musí být
  /// zmrazený stejně jako doručovací adresa a `cenaVDobeNakupu`.
  mezisoucet          Decimal       @default(0)
  slevaCastka         Decimal       @default(0)
  cenaDopravy         Decimal       @default(0)

  /// Součet zboží po slevě + doprava, tedy hodnota objednávky **před**
  /// uplatněním dárkového poukazu. Co zbývá doplatit = `celkovaCena - castkaZGiftCard`.
  celkovaCena         Decimal
  discountCodeId      String?
  discountCode        DiscountCode? @relation(fields: [discountCodeId], references: [id])
  giftCardId          String?
  giftCard            GiftCard?     @relation(fields: [giftCardId], references: [id])
  castkaZGiftCard     Decimal?
  zpusobDopravy       String
  vydejniMistoId      String?
  vydejniMistoNazev   String?
  zpusobPlatby        String
  stavPlatby          String

  /// Identifikátor platby u brány (GoPay). Notifikace i návratová adresa
  /// nesou jen tohle id, takže je to jediná vazba mezi objednávkou a platbou.
  /// Unikátní schválně: jedna platba nesmí označit za zaplacené dvě objednávky.
  platbaId            String?       @unique

  cisloZasilky        String?
  poznamka            String?
  zrusil              ZrusilKdo?
  dodaciJmenoPrijmeni String
  dodaciUlice         String
  dodaciMesto         String
  dodaciPsc           String
  dodaciZeme          String        @default("CZ")
  dodaciTelefon       String?
  createdAt           DateTime      @default(now())
  items               OrderItem[]
  reklamace           Reklamace[]

  @@index([userId])
  @@index([stav, createdAt])
}

enum ZrusilKdo {
  ZAKAZNICE
  ADMIN
}

enum OrderStatus {
  NOVA
  ZPRACOVAVA_SE
  EXPEDOVANA
  DORUCENA
  ZRUSENA
  VRACENA
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])
  mnozstvi            Int
  cenaVDobeNakupu     Decimal
  reklamace           Reklamace[]
  vygenerovanePoukazy GiftCard[]
}

model Favorite {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  upozornenoNaSklad Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, productId])
}

model DiscountCode {
  id            String    @id @default(cuid())
  kod           String    @unique
  procentoSlevy Int
  platnyOd      DateTime?
  platnyDo      DateTime?
  limitPouziti  Int?
  pocetPouziti  Int       @default(0)
  aktivni       Boolean   @default(true)
  orders        Order[]
}

model GiftCard {
  id                     String     @id @default(cuid())
  kod                    String     @unique
  castka                 Decimal
  zustatek               Decimal
  platnyDo               DateTime?
  aktivni                Boolean    @default(true)
  vytvorenoZObjednavkyId String?
  vytvorenoZObjednavky   OrderItem? @relation(fields: [vytvorenoZObjednavkyId], references: [id])
  createdAt              DateTime   @default(now())
  orders                 Order[]
}

model Settings {
  id                    Int       @id @default(1)
  rezimDovolene         Boolean   @default(false)
  datumNavratu          DateTime?
  zpravaProZakazniky    String?
  zablokovatObjednavky  Boolean   @default(false)
  nazevFirmy            String?
  icoFirmy              String?
  dicFirmy              String?
  adresaFirmy           String?
  telefonFirmy          String?
  emailFirmy            String?
  jePlatceDph           Boolean   @default(false)
  socialInstagram       String?
  socialFacebook        String?
  cenaDopravyZasilkovna Decimal?
  cenaDopravyPPL        Decimal?
  cenaDopravyCeskaPosta Decimal?
  prahDopravaZdarma     Decimal?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  potvrzeno Boolean  @default(false)
  /// Odkud přihlášení přišlo – "hero", "paticka". Kvůli měření, ne kvůli funkci.
  zdroj     String?
  odhlasenAt DateTime?

  /// Klíč do odhlašovacího odkazu (a později do potvrzení double opt-inu).
  /// E-mail se do odkazu dát nesmí: kdokoliv by pak odhlásil kohokoliv,
  /// komu uhodne adresu. Token je náhodný a váže se na jediný záznam.
  token     String   @unique @default(cuid())

  createdAt DateTime @default(now())
}

model StockNotification {
  id        String         @id @default(cuid())
  email     String
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vyrizeno  Boolean        @default(false)
  createdAt DateTime       @default(now())

  // Jeden e-mail hlídá jednu velikost jednou – bez toho by opakované kliknutí
  // založilo hlídání znovu a zákaznici přišlo několik stejných zpráv.
  @@unique([variantId, email])
  @@index([vyrizeno])
}

/// Zprávy z kontaktního formuláře (sekce 12).
/// Ukládají se do databáze, ne jen odesílají e-mailem: dokud nejsou SMTP
/// přístupy, byla by odeslaná zpráva nenávratně ztracená.
model ContactMessage {
  id        String   @id @default(cuid())
  jmeno     String
  email     String
  predmet   String?
  zprava    String
  vyrizeno  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vyrizeno, createdAt])
}

model Reklamace {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId    String?
  orderItem      OrderItem?    @relation(fields: [orderItemId], references: [id])
  typ            ReklamaceTyp
  stav           ReklamaceStav @default(PRIJATA)
  duvod          String?
  poznamkaAdmina String?
  datumPrijeti   DateTime      @default(now())
  datumVyrizeni  DateTime?

  // Zákaznice si v účtu vypisuje reklamace ke svým objednávkám; admin je
  // řadí podle stavu. Bez indexu na `orderId` je první z toho sekvenční sken.
  @@index([orderId])
  @@index([stav, datumPrijeti])
}

enum ReklamaceTyp {
  REKLAMACE
  VRACENI
}

enum ReklamaceStav {
  PRIJATA
  RESI_SE
  VYRIZENA_UZNANA
  VYRIZENA_ZAMITNUTA
}

// Jednoduchý audit log akcí administrátora (sekce 14) – kdo, kdy a co změnil.
// Schválně bez cizího klíče na User: záznam musí přežít i smazání účtu admina.
model AuditLog {
  id          String   @id @default(cuid())
  adminEmail  String
  akce        String // např. "produkt.vytvoren", "produkt.skryt"
  entita      String // např. "Product"
  entitaId    String?
  podrobnosti Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
